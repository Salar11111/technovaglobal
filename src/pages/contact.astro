---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/forms/ContactForm.tsx';
---

<Base
  title="Contact Us | TechNova Systems"
  description="Get in touch with TechNova Systems — request a consultation, demo, or reach our global support team."
  currentPath="/contact"
>
  <section
    class="hero"
    style="min-height: 50vh; padding-top: 150px;"
    aria-labelledby="contact-hero-title"
  >
    <div class="container">
      <span class="tag">Let's Talk</span>
      <h1 id="contact-hero-title" class="gradient-text">
        Let's Build the
        <br />
        <span>Future Together</span>
      </h1>
      <p class="subtitle">
        Reach out to our global headquarters or find a local hub near you. We typically respond
        within 24 hours.
      </p>
    </div>
  </section>

  <section class="contact-section" aria-labelledby="contact-form-title">
    <div class="container">
      <div class="contact-layout">
        <!-- Contact Info -->
        <div>
          <div class="glass info-card">
            <div class="info-icon" aria-hidden="true">🏢</div>
            <h4>Global Headquarters</h4>
            <p>
              500 Tech Plaza
              <br />
              San Francisco, CA 94102
              <br />
              United States
            </p>
          </div>
          <div class="glass info-card">
            <div class="info-icon" aria-hidden="true">📧</div>
            <h4>Email Us</h4>
            <p>contact@technova.global</p>
            <p>support@technova.global</p>
          </div>
          <div class="glass info-card">
            <div class="info-icon" aria-hidden="true">⏰</div>
            <h4>Always Available</h4>
            <p>
              Enterprise support is
              <br />
              available 24/7/365 globally.
            </p>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="glass form-card">
          <span class="tag">Send a Message</span>
          <h2 id="contact-form-title">
            Get In Touch
          </h2>
          <p>Fill out the form and our team will reach out within 24 hours.</p>
          <ContactForm client:visible />
        </div>
      </div>
    </div>
  </section>
</Base>
