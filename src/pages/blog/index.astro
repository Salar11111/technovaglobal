---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Base
  title="Blog | TechNova Systems"
  description="Latest updates, insights, and announcements from TechNova."
  currentPath="/blog"
>
  <section class="hero" style="min-height: 50vh; padding-top: 150px;" aria-labelledby="blog-hero-title">
    <div class="container reveal">
      <span class="tag">Engineering Blog</span>
      <h1 id="blog-hero-title" class="gradient-text">Insights from the<br><span>Frontier</span></h1>
      <p class="subtitle">Deep dives into our technology, architecture decisions, and the future of global infrastructure.</p>
    </div>
  </section>

  <section class="blog-grid">
    <div class="container">
      <SectionHeader tag="Latest Posts" title="Recent Articles" />
      <div class="grid-blog">
        {posts.map(post => (
          <article class="blog-card glass reveal">
            {post.data.image && (
              <div class="blog-image" style={{ backgroundImage: `url(${post.data.image})` }} />
            )}
            <div class="blog-content">
              <div class="blog-meta">
                <time>{post.data.publishDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
                <span class="blog-author">by {post.data.author}</span>
              </div>
              <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <div class="blog-tags">
                {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
              <a href={`/blog/${post.id}/`} class="btn btn-outline" style="margin-top: 1rem;">Read More →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <style>
    .blog-grid { padding: var(--space-32) 0; }
    .grid-blog {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
    }
    .blog-card {
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .blog-image {
      height: 200px;
      background-size: cover;
      background-position: center;
    }
    .blog-content {
      padding: 2rem;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .blog-meta {
      display: flex;
      gap: 1.5rem;
      font-size: 0.85rem;
      color: var(--color-text-muted);
      margin-bottom: 1rem;
    }
    .blog-content h3 {
      font-size: 1.35rem;
      margin-bottom: 0.75rem;
      line-height: 1.3;
    }
    .blog-content h3 a:hover { color: var(--color-primary); }
    .blog-content p {
      color: var(--color-text-dim);
      flex: 1;
      margin-bottom: 1.5rem;
    }
    .blog-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }
  </style>
</Base>