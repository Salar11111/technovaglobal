---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = (await getCollection('changelog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Changelog | TechNova Systems"
  description="Track all platform updates, new features, and fixes."
  currentPath="/changelog"
>
  <section class="hero" style="min-height: 50vh; padding-top: 150px;" aria-labelledby="changelog-hero-title">
    <div class="container">
      <span class="tag">Platform Updates</span>
      <h1 id="changelog-hero-title" class="gradient-text">Changelog</h1>
      <p class="subtitle">Every release, improvement, and fix — documented for transparency.</p>
    </div>
  </section>

  <section class="changelog-section">
    <div class="container">
      {entries.map(entry => (
        <section class="changelog-entry glass" id={entry.data.version}>
          <header class="entry-header">
            <div>
              <span class="tag">{entry.data.version}</span>
              <time class="entry-date">{entry.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
            </div>
            <h2>{entry.data.title}</h2>
          </header>
          <div class="entry-changes">
            {entry.data.changes.map(change => (
              <div class={`change-item change-${change.type}`}>
                <span class="change-type">{change.type.toUpperCase()}</span>
                <p>{change.description}</p>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <style>
    .changelog-entry { margin-bottom: var(--s-5); padding: var(--s-6); }
    .entry-header { margin-bottom: var(--s-5); }
    .entry-header .tag { margin-bottom: var(--s-2); }
    .entry-date { color: var(--muted); font-size: 0.875rem; }
    .entry-header h2 { margin-top: var(--s-2); }
    .entry-changes { display: flex; flex-direction: column; gap: var(--s-3); }
    .change-item {
      display: flex;
      align-items: flex-start;
      gap: var(--s-4);
      padding: var(--s-3) var(--s-4);
      background: var(--surface-2);
      border: 1px solid var(--line);
      border-left: 2px solid var(--accent);
      border-radius: var(--r-btn);
    }
    .change-type {
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: var(--s-1) var(--s-2);
      border-radius: var(--r-full);
      white-space: nowrap;
      align-self: flex-start;
    }
    .change-item p { color: var(--muted); font-size: 0.9375rem; }
    .change-added { border-left-color: var(--ok); }
    .change-added .change-type { background: rgba(52, 211, 153, 0.14); color: var(--ok); }
    .change-changed { border-left-color: var(--info); }
    .change-changed .change-type { background: var(--accent-soft); color: var(--accent); }
    .change-fixed { border-left-color: var(--warn); }
    .change-fixed .change-type { background: rgba(251, 191, 36, 0.14); color: var(--warn); }
    .change-removed { border-left-color: var(--danger); }
    .change-removed .change-type { background: rgba(251, 113, 133, 0.14); color: var(--danger); }
    .change-security { border-left-color: var(--security); }
    .change-security .change-type { background: rgba(34, 211, 238, 0.14); color: var(--security); }
  </style>
</Base>