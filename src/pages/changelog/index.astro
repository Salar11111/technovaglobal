---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = (await getCollection('changelog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Changelog | TechNova Systems"
  description="Track all platform updates, new features, and fixes."
  currentPath="/changelog"
>
  <section class="hero" style="min-height: 50vh; padding-top: 150px;" aria-labelledby="changelog-hero-title">
    <div class="container reveal">
      <span class="tag">Platform Updates</span>
      <h1 id="changelog-hero-title" class="gradient-text">Changelog</h1>
      <p class="subtitle">Every release, improvement, and fix — documented for transparency.</p>
    </div>
  </section>

  <section class="changelog-section">
    <div class="container">
      {entries.map(entry => (
        <section class="changelog-entry glass reveal" id={entry.data.version}>
          <header class="entry-header">
            <div>
              <span class="tag">{entry.data.version}</span>
              <time class="entry-date">{entry.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
            </div>
            <h2>{entry.data.title}</h2>
          </header>
          <div class="entry-changes">
            {entry.data.changes.map(change => (
              <div class={`change-item change-${change.type}`}>
                <span class="change-type">{change.type.toUpperCase()}</span>
                <p>{change.description}</p>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <style>
    .changelog-section { padding: var(--space-32) 0; }
    .changelog-entry { margin-bottom: 3rem; padding: 2.5rem; }
    .entry-header { margin-bottom: 2rem; }
    .entry-header .tag { margin-bottom: 0.5rem; }
    .entry-date { color: var(--color-text-muted); font-size: 0.9rem; margin-left: 1rem; }
    .entry-header h2 { margin-top: 0.5rem; }
    .entry-changes { display: flex; flex-direction: column; gap: 1rem; }
    .change-item {
      display: flex;
      gap: 1rem;
      padding: 1rem;
      background: rgba(255,255,255,0.02);
      border-radius: var(--radius-sm);
      border-left: 4px solid var(--color-primary);
    }
    .change-type {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 0.25rem 0.75rem;
      border-radius: var(--radius-full);
      white-space: nowrap;
      align-self: flex-start;
    }
    .change-added .change-type { background: rgba(16, 185, 129, 0.2); color: #10b981; }
    .change-changed .change-type { background: rgba(59, 130, 246, 0.2); color: #3b82f6; }
    .change-fixed .change-type { background: rgba(245, 158, 11, 0.2); color: #f59e0b; }
    .change-removed .change-type { background: rgba(239, 68, 68, 0.2); color: #ef4444; }
    .change-security .change-type { background: rgba(139, 92, 246, 0.2); color: #8b5cf6; }
  </style>
</Base>