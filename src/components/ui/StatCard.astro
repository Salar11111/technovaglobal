---
interface Props {
  icon: string;
  target: number;
  label: string;
  delay?: number;
  class?: string;
}
const { icon, target, label, class: className = '' } = Astro.props;
---
<div class={`stat-card glass ${className}`}>
  <span class="stat-icon" aria-hidden="true">{icon}</span>
  <h2 class="counter" data-target={target}>{target.toLocaleString('en-US')}</h2>
  <p>{label}</p>
</div>
