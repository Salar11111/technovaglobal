---
interface Props {
  quote: string;
  author: string;
  role: string;
  avatar: string;
  delay?: number;
  class?: string;
}
const { quote, author, role, avatar, class: className = '' } = Astro.props;
---
<div class={`testimonial-card glass ${className}`}>
  <div class="quote-mark" aria-hidden="true">"</div>
  <p>{quote}</p>
  <div class="testimonial-author">
    <div class="author-avatar" aria-hidden="true">{avatar}</div>
    <div>
      <div class="author-name">{author}</div>
      <div class="author-role">{role}</div>
    </div>
  </div>
</div>
