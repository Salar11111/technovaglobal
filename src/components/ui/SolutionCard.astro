---
interface Props {
  icon: string;
  title: string;
  description: string;
  features?: string[];
  delay?: number;
  class?: string;
}
const { icon, title, description, features = [], class: className = '' } = Astro.props;
---
<div class={`solution-card glass ${className}`}>
  <span class="card-icon" aria-hidden="true">{icon}</span>
  <h3>{title}</h3>
  <p>{description}</p>
  {features.length > 0 && (
    <ul class="solution-features">
      {features.map(feature => <li><span aria-hidden="true">✓</span> {feature}</li>)}
    </ul>
  )}
</div>
