---
interface Props {
  name: string;
  role: string;
  initials: string;
  delay?: number;
  class?: string;
}
const { name, role, initials, class: className = '' } = Astro.props;
---
<div class={`team-card glass ${className}`}>
  <div class="team-avatar" aria-hidden="true">{initials}</div>
  <h4>{name}</h4>
  <span>{role}</span>
</div>
