# TechNova Environment Variables
# Copy this to .env and fill in your values

# Analytics (Umami)
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
PUBLIC_UMAMI_WEBSITE_ID=your-website-id-here

# Contact Form (Netlify Forms - works automatically on Netlify)
# No additional config needed for Netlify Forms

# Alternative: Formspree
# PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Site URL (for sitemap, canonical URLs)
PUBLIC_SITE_URL=https://technova.global